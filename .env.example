# AgentMax local closed-beta development defaults.
# Copy to .env for local dev only. Do not use these placeholder secrets in production.

APP_NAME=AgentMax
APP_VERSION=0.1.0-beta.1
ENVIRONMENT=development
DEBUG=false

# Local API/runtime
AGENTMAX_HOST=127.0.0.1
AGENTMAX_API_PORT=7790
AGENTMAX_WS_PORT=7788
AGENTMAX_IPC_AUTH=1

# Local model providers
AGENTMAX_AI_BACKEND=lmstudio
AGENTMAX_LMS_HOST=127.0.0.1
AGENTMAX_LMS_PORT=1234
AGENTMAX_MODEL=agentmax-local
AGENTMAX_API_BASE_URL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional llama.cpp sidecar
AGENTMAX_LLAMA_HOST=127.0.0.1
AGENTMAX_LLAMA_PORT=8080
AGENTMAX_LLAMA_SERVER_BIN=llama-server
AGENTMAX_GGUF_MODEL_PATH=
AGENTMAX_LLAMA_CONTEXT=4096
AGENTMAX_LLAMA_THREADS=0
AGENTMAX_LLAMA_GPU_LAYERS=0

# Closed-beta feature defaults
AGENTMAX_FEATURE_SQLITE_STORAGE=1
AGENTMAX_FEATURE_SCREEN_VISION=1
AGENTMAX_FEATURE_LOCAL_AGENTPILOT=1
AGENTMAX_FEATURE_MOUSE_CONTROL=0
AGENTMAX_FEATURE_KEYBOARD_CONTROL=0
AGENTMAX_FEATURE_TERMINAL=0
AGENTMAX_FEATURE_FILE_ACTIONS=0
AGENTMAX_FEATURE_CLOUD_AGENTPILOT=0
AGENTMAX_FEATURE_TELEMETRY=0
AGENTMAX_FEATURE_CRASH_REPORTS=0
AGENTMAX_FEATURE_REDIS_QUEUE=0

# Safety / telemetry
ENABLE_TELEMETRY=0
AGENTMAX_DEV_BYPASS=0

# Development-only placeholders. Replace before any hosted/server deployment.
SECRET_KEY=agentmax-local-dev-secret-not-for-production-000000000000
ADMIN_SECRET=agentmax-local-admin-secret-not-for-production-0000000000
