# AgentMax — example environment configuration.
# Copy to .env and fill in real values. NEVER commit a real .env.
# Every variable is optional unless marked (required); defaults shown are the
# built-in ones from core/config.py.

# ── AI backend ───────────────────────────────────────────────────────────────
# Which brain drives the agent: claude | lmstudio | local_peft | llamacpp
AGENTMAX_BACKEND=claude
# (required for backend=claude)
ANTHROPIC_API_KEY=
AGENTMAX_MODEL=claude-sonnet-4-6
# Optional separate vision model (defaults to AGENTMAX_MODEL)
AGENTMAX_VISION_MODEL=
AGENTMAX_MAX_TOKENS=4096
AGENTMAX_TEMPERATURE=0.4

# LM Studio (backend=lmstudio)
AGENTMAX_LMS_HOST=127.0.0.1
AGENTMAX_LMS_PORT=1235

# llama.cpp (backend=llamacpp) — path to GGUF + llama-server binary
AGENTMAX_LLAMA_MODEL_PATH=
AGENTMAX_LLAMA_SERVER_BIN=llama-server
AGENTMAX_LLAMA_PORT=8080
AGENTMAX_LLAMA_GPU_LAYERS=0

# ── Desktop runtime (IPC servers bind to loopback by default) ────────────────
AGENTMAX_HOST=127.0.0.1
AGENTMAX_WS_PORT=7788
AGENTMAX_API_PORT=7790
# Require an auth token on the local IPC API
AGENTMAX_IPC_AUTH=0

# ── Licensing ────────────────────────────────────────────────────────────────
# License key issued to the user
AGENTMAX_LICENSE=
AGENTMAX_WHOP_KEY=
# Development bypass — NEVER ship enabled
AGENTMAX_DEV_BYPASS=0

# ── Telemetry & beta data (both opt-in, default OFF) ─────────────────────────
ENABLE_TELEMETRY=0
TELEMETRY_ENDPOINT=
AGENTMAX_BETA_DATA_OPTIN=0

# ── Backend service (backend/ FastAPI — server deployments only) ─────────────
# (required by the backend service; must NOT start with CHANGE_ME)
SECRET_KEY=
ADMIN_SECRET=
DATABASE_URL=postgresql+asyncpg://AgentMax:AgentMax@localhost:5432/AgentMax
REDIS_URL=redis://localhost:6379/0
# Ed25519/AES key material for the license protocol (hex)
ED25519_PRIVATE_KEY_HEX=
AES_MASTER_KEY_HEX=
